# 이 파일을 .env로 복사해 값을 채워요. .env는 git에 올리지 않아요.

# PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/carnot
DB_USER=carnot
DB_PASSWORD=change-me

# HTTPS로 서비스할 때 true (세션 쿠키에 Secure를 붙여요)
COOKIE_SECURE=false

# 시연 데이터 (개발·시연용). 운영에서는 false로 두세요.
DEMO_SEED=false
DEMO_PASSWORD=demo1234

# 메일 (가입 인증번호 · 임시 비밀번호). 비워 두면 서버 로그에만 남아요.
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=no-reply@example.com

# AI (회의록 초안 · 영수증 읽기). 비워 두면 화면은 '예시 초안'으로 동작해요.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
AI_MODEL_QUICK=claude-haiku-5-5
